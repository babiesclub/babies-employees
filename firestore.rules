rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOffice() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'office';
    }

    // Per-office-employee permission flag lookup. `perm` is one of the
    // documented keys (adm_gardens, adm_animals, op_delete, op_reset_pw, ...).
    // Missing map/missing key ⇒ allow (backwards-compat with existing office
    // users that were created before the officePermissions map existed).
    // Explicit `false` denies. Admins always pass — they use isAdmin() gates.
    function hasOfficePerm(perm) {
      return isOffice()
        && (!('officePermissions' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || !(perm in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.officePermissions)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.officePermissions[perm] != false);
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function affectsOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // USERS
    // Instructors may only update a small whitelist on their own doc (profile + push tokens).
    // role, salary rates, gardens, adminSignature, unlockedMonths, camps* — ADMIN ONLY.
    // Office employees may manage instructor docs if they have `adm_instructors`,
    // but never touch an admin's doc and never grant/revoke office perms — those
    // sit inside the `officePermissions` map that ONLY isAdmin() writes.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        hasOfficePerm('adm_instructors')
        && request.resource.data.role != 'admin'
        && request.resource.data.role != 'office'
      );
      allow update: if isAdmin() || (
        isSelf(uid) && affectsOnly([
          'name','phone','email','tz','address','gender',
          'oneSignalSubscriptionIds','oneSignalSubscriptionId',
          'fcmToken','lastSeen','pushEnabled',
          'scheduleApprovedAt','scheduleApprovedBy',
          'dogMatProgress'
        ])
      ) || (
        hasOfficePerm('adm_instructors')
        && resource.data.role != 'admin'
        && resource.data.role != 'office'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['officePermissions','role'])
      );
      allow delete: if isAdmin() || (
        hasOfficePerm('adm_instructors')
        && hasOfficePerm('op_delete')
        && resource.data.role != 'admin'
        && resource.data.role != 'office'
      );
    }

    // GARDENS
    match /gardens/{gardenId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || hasOfficePerm('adm_gardens');
      allow delete: if isAdmin() || (hasOfficePerm('adm_gardens') && hasOfficePerm('op_delete'));
    }

    // VIRTUAL INSTRUCTORS — planned/pending positions that don't have a real Firebase Auth account.
    // Admin-only. Participates in rotation algorithm (task #128) but excluded from salary/WA/client-facing.
    match /virtualInstructors/{docId} {
      allow read, write: if isAdmin();
    }

    // RECORDS — instructors log their own attendance
    match /records/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (
        isAdmin()
        || (isOffice() && hasOfficePerm('op_delete'))
        || (!isOffice() && !isAdmin())  // instructor deleting own record — existing behaviour
      );
    }

    // INVOICES — ADMIN ONLY
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    // CONTRACTS — read own or admin, sign own, admin creates
    match /contracts/{contractId} {
      allow read: if isSignedIn() && (isAdmin() || hasOfficePerm('adm_instructors') || resource.data.instructorUid == request.auth.uid);
      allow create: if isAdmin() || hasOfficePerm('adm_instructors');
      allow update: if isAdmin() || hasOfficePerm('adm_instructors') || (
        resource.data.instructorUid == request.auth.uid
        && resource.data.status == 'pending'
      );
      allow delete: if isAdmin() || (hasOfficePerm('adm_instructors') && hasOfficePerm('op_delete'));
    }

    // PERSONAL DOCS — sensitive PII (id card, bank confirmation)
    match /personalDocs/{docId} {
      allow read: if isSignedIn() && (isAdmin() || hasOfficePerm('adm_instructors') || resource.data.instructorUid == request.auth.uid);
      allow create: if isSignedIn() && (
        request.resource.data.instructorUid == request.auth.uid
        || isAdmin()
        || hasOfficePerm('adm_instructors')
      );
      allow update: if isAdmin() || hasOfficePerm('adm_instructors') || (
        resource.data.instructorUid == request.auth.uid
      );
      allow delete: if isAdmin() || (hasOfficePerm('adm_instructors') && hasOfficePerm('op_delete')) || (
        resource.data.instructorUid == request.auth.uid
      );
    }

    // RECEIPTS — instructor writes own; admin reads all
    match /receipts/{docId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.instructorUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.instructorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (
        resource.data.instructorUid == request.auth.uid
      );
    }

    // TASKS
    match /tasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    // NOTIFICATIONS — recipients read their own; anyone signed-in may create
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.recipientUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (
        resource.data.recipientUid == request.auth.uid
      );
    }

    // CHAT MESSAGES — participants + admin
    // Field is `threadUid` (the instructor whose thread this is), plus
    // `senderUid`. Instructor queries only her own thread via
    // .where('threadUid', '==', uid) — the get rule below matches per-doc.
    match /chatMessages/{msgId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.threadUid == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // WHATSAPP — ADMIN ONLY (both legacy and current naming)
    match /waConversations/{convId}   { allow read, write: if isAdmin(); }
    match /waMessages/{msgId}         { allow read, write: if isAdmin(); }
    match /whatsapp_conversations/{convId} { allow read, write: if isAdmin(); }
    match /whatsapp_messages/{msgId}       { allow read, write: if isAdmin(); }

    // TENDERS + COMPANY DOCS — ADMIN ONLY
    match /tenders/{docId}      { allow read, write: if isAdmin(); }
    match /companyDocs/{docId}  { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // SETTINGS / SEND LOG / SCHEDULED NOTIFICATIONS / EXTERNAL SCHEDULES — ADMIN ONLY
    match /settings/{docId}             { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /sendLog/{docId}              { allow read, write: if isAdmin(); }
    match /customNotifications/{docId}  { allow read, write: if isAdmin(); }
    match /external_schedules/{docId}   { allow read, write: if isAdmin(); }
    match /regionRoutes/{docId}         { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /rotationGroups/{docId}       { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // MATERIALS / WEEKLY SCHEDULE / ANIMALS — read all, write admin or scoped office
    match /materials/{matId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || hasOfficePerm('adm_materials');
      allow delete: if isAdmin() || (hasOfficePerm('adm_materials') && hasOfficePerm('op_delete'));
    }
    match /dogMaterials/{matId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || hasOfficePerm('adm_materials');
      allow delete: if isAdmin() || (hasOfficePerm('adm_materials') && hasOfficePerm('op_delete'));
    }
    match /weeklySchedule/{weekId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || hasOfficePerm('adm_wsch');
      allow delete: if isAdmin() || (hasOfficePerm('adm_wsch') && hasOfficePerm('op_delete'));
    }
    match /animals/{animalId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || hasOfficePerm('adm_animals');
      allow delete: if isAdmin() || (hasOfficePerm('adm_animals') && hasOfficePerm('op_delete'));
    }

    // CAMP SESSIONS — read/write for signed-in (self-service marking)
    match /camp_sessions/{sessId}   { allow read, write: if isSignedIn(); }
    match /camp_clients/{clientId}  { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // SUBSTITUTE ASSIGNMENTS — admin manages, all read
    match /substituteAssignments/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ADMIN CALENDAR (הכשרות, פגישות, אירועים) — admin only
    match /adminCalendarEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    // INSTRUCTOR REPORTS (monthly attendance PDF, published by admin)
    // Admin writes; instructor reads only her own docs.
    match /instructorReports/{reportId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.instructorUid == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // SALARY PAYMENTS — admin-only. Tracks per-month payment status per instructor.
    // Not exposed to the instructor (she sees only the published instructorReports PDF).
    match /salaryPayments/{docId} {
      allow read, write: if isAdmin();
    }

    // MONTHLY REPORTS — instructor reads her own + updates status via submitmonthlyapproval CF.
    // Admin has full access. Direct client update on status by the instructor is blocked;
    // she must call the callable Cloud Function (which sets it server-side under admin creds).
    match /monthlyReports/{docId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.instructorUid == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    // SALARY ADJUSTMENTS — bonuses / deductions applied to a future month's salary.
    // Instructor may READ her own to see her expected paycheck; only admin writes.
    match /salaryAdjustments/{docId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.uid == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // SCHEDULED TASKS — deferred work items processed by runscheduledtasks CF.
    // Admin only from client; the CF runs under admin credentials.
    match /scheduledTasks/{docId} {
      allow read, write: if isAdmin();
    }

    // META (gardens, animals lists, etc.) — read all, write admin.
    // networkSettings gets a specific matcher above the generic meta rule so office
    // employees with adm_gardens can edit network-level pricing (consistent with
    // how they edit individual gardens under the /gardens/{gardenId} rule).
    match /meta/networkSettings {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasOfficePerm('adm_gardens');
    }
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // EMAIL IMPORTS (invoices/receipts pulled from Gmail) — ADMIN ONLY
    match /emailImports/{docId} {
      allow read, write: if isAdmin();
    }

    // OCR LOGS (Claude Vision receipt-parse audit trail) — ADMIN ONLY.
    // Writes come from the CF under admin credentials; instructor never reads/writes directly.
    match /ocrLogs/{docId} {
      allow read, write: if isAdmin();
    }

    // GMAIL TOKENS (refresh_token per connected Gmail account) — ADMIN ONLY
    // Contains sensitive OAuth refresh_token; even read is admin-only.
    match /gmailTokens/{accountKey} {
      allow read, write: if isAdmin();
    }

    // GMAIL OAUTH STATE (short-lived CSRF nonces) — ADMIN ONLY
    match /gmailOAuthState/{nonce} {
      allow read, write: if isAdmin();
    }

    // FINAL DENY — anything not matched above is closed.
    // This replaces the previous permissive catch-all that allowed any signed-in user
    // to read/write unlisted collections (including sensitive ones we hadn't declared).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
